<!-- Generated by app/tools/make_skins.py; edit the table there. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- IDE dark: a dark editor look, one blue accent. -->

    <!-- window background -->
    <SolidColorBrush x:Key="Zf.Window" Color="#1E1E1E" />
    <!-- panel background -->
    <SolidColorBrush x:Key="Zf.Panel" Color="#252526" />
    <!-- panel heading text -->
    <SolidColorBrush x:Key="Zf.PanelHeader" Color="#9DA5B4" />
    <!-- panel and control borders -->
    <SolidColorBrush x:Key="Zf.Border" Color="#3C3C3C" />
    <!-- normal text -->
    <SolidColorBrush x:Key="Zf.Text" Color="#D4D4D4" />
    <!-- secondary text -->
    <SolidColorBrush x:Key="Zf.DimText" Color="#8B8F98" />
    <!-- selected / on -->
    <SolidColorBrush x:Key="Zf.Accent" Color="#3794FF" />
    <!-- text on the accent -->
    <SolidColorBrush x:Key="Zf.AccentText" Color="#FFFFFF" />
    <!-- errors -->
    <SolidColorBrush x:Key="Zf.Error" Color="#F48771" />
    <!-- warnings -->
    <SolidColorBrush x:Key="Zf.Warning" Color="#CCA700" />
    <!-- button face -->
    <SolidColorBrush x:Key="Zf.ButtonBackground" Color="#333337" />
    <!-- button border -->
    <SolidColorBrush x:Key="Zf.ButtonBorder" Color="#45454A" />
    <!-- button face, hovered -->
    <SolidColorBrush x:Key="Zf.ButtonHover" Color="#3E3E42" />
    <!-- button face, pressed -->
    <SolidColorBrush x:Key="Zf.ButtonPressed" Color="#094771" />
    <!-- button text -->
    <SolidColorBrush x:Key="Zf.ButtonText" Color="#E0E0E0" />
    <!-- text boxes and lists -->
    <SolidColorBrush x:Key="Zf.InputBackground" Color="#1E1E1E" />
    <!-- text in boxes and lists -->
    <SolidColorBrush x:Key="Zf.InputText" Color="#D4D4D4" />
    <!-- selected list item -->
    <SolidColorBrush x:Key="Zf.Selection" Color="#264F78" />
    <!-- terminal -->
    <SolidColorBrush x:Key="Zf.TerminalBackground" Color="#181818" />
    <!-- terminal text -->
    <SolidColorBrush x:Key="Zf.TerminalText" Color="#CCCCCC" />
    <!-- editor -->
    <SolidColorBrush x:Key="Zf.EditorBackground" Color="#1E1E1E" />
    <!-- editor text -->
    <SolidColorBrush x:Key="Zf.EditorText" Color="#D4D4D4" />
    <!-- text caret -->
    <SolidColorBrush x:Key="Zf.Caret" Color="#AEAFAD" />
    <!-- board view background -->
    <SolidColorBrush x:Key="Zf.BoardBackground" Color="#1E1E1E" />
    <!-- the board itself -->
    <SolidColorBrush x:Key="Zf.BoardPcb" Color="#1F3B2B" />
    <!-- silkscreen text -->
    <SolidColorBrush x:Key="Zf.BoardText" Color="#E6E6E6" />
    <!-- LD0..LD3 lit -->
    <SolidColorBrush x:Key="Zf.LedOn" Color="#4CFF6A" />
    <!-- LED dark -->
    <SolidColorBrush x:Key="Zf.LedOff" Color="#2A332C" />
    <!-- input pin reading 1 -->
    <SolidColorBrush x:Key="Zf.PinHigh" Color="#7FB8FF" />
    <!-- input pin reading 0 -->
    <SolidColorBrush x:Key="Zf.PinLow" Color="#3A3F46" />
    <!-- output pin driving 1 -->
    <SolidColorBrush x:Key="Zf.PinDriven" Color="#FF6B4A" />
    <!-- output pin driving 0 -->
    <SolidColorBrush x:Key="Zf.PinDrivenLow" Color="#7A2E20" />
    <!-- pin owned by PWM -->
    <SolidColorBrush x:Key="Zf.PinPwm" Color="#C586C0" />
    <!-- push button cap -->
    <SolidColorBrush x:Key="Zf.ButtonCap" Color="#5A5F66" />
    <!-- push button pressed -->
    <SolidColorBrush x:Key="Zf.ButtonCapPressed" Color="#3794FF" />

    <FontFamily x:Key="Zf.UiFont">Segoe UI</FontFamily>
    <FontFamily x:Key="Zf.CodeFont">Cascadia Mono, Consolas</FontFamily>
    <sys:Double x:Key="Zf.UiSize">12</sys:Double>
    <sys:Double x:Key="Zf.CodeSize">13</sys:Double>
    <CornerRadius x:Key="Zf.Radius">2</CornerRadius>

    <!-- glow on terminal and editor text (retro skins), else none -->
    <x:Null x:Key="Zf.TextGlow" />

</ResourceDictionary>
