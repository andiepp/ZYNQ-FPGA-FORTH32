<!-- Generated by app/tools/make_skins.py; edit the table there. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Amber: a P3 CRT terminal, glowing amber on black. -->

    <!-- window background -->
    <SolidColorBrush x:Key="Zf.Window" Color="#0A0600" />
    <!-- panel background -->
    <SolidColorBrush x:Key="Zf.Panel" Color="#120C02" />
    <!-- panel heading text -->
    <SolidColorBrush x:Key="Zf.PanelHeader" Color="#D99600" />
    <!-- panel and control borders -->
    <SolidColorBrush x:Key="Zf.Border" Color="#5C4000" />
    <!-- normal text -->
    <SolidColorBrush x:Key="Zf.Text" Color="#FFB000" />
    <!-- secondary text -->
    <SolidColorBrush x:Key="Zf.DimText" Color="#A87400" />
    <!-- selected / on -->
    <SolidColorBrush x:Key="Zf.Accent" Color="#FFB000" />
    <!-- text on the accent -->
    <SolidColorBrush x:Key="Zf.AccentText" Color="#140C00" />
    <!-- errors -->
    <SolidColorBrush x:Key="Zf.Error" Color="#FF5030" />
    <!-- warnings -->
    <SolidColorBrush x:Key="Zf.Warning" Color="#FFE070" />
    <!-- button face -->
    <SolidColorBrush x:Key="Zf.ButtonBackground" Color="#2A1C00" />
    <!-- button border -->
    <SolidColorBrush x:Key="Zf.ButtonBorder" Color="#8A6000" />
    <!-- button face, hovered -->
    <SolidColorBrush x:Key="Zf.ButtonHover" Color="#4A3200" />
    <!-- button face, pressed -->
    <SolidColorBrush x:Key="Zf.ButtonPressed" Color="#8A6000" />
    <!-- button text -->
    <SolidColorBrush x:Key="Zf.ButtonText" Color="#FFB000" />
    <!-- text boxes and lists -->
    <SolidColorBrush x:Key="Zf.InputBackground" Color="#0A0600" />
    <!-- text in boxes and lists -->
    <SolidColorBrush x:Key="Zf.InputText" Color="#FFB000" />
    <!-- selected list item -->
    <SolidColorBrush x:Key="Zf.Selection" Color="#5A3E00" />
    <!-- terminal -->
    <SolidColorBrush x:Key="Zf.TerminalBackground" Color="#080500" />
    <!-- terminal text -->
    <SolidColorBrush x:Key="Zf.TerminalText" Color="#FFB52E" />
    <!-- editor -->
    <SolidColorBrush x:Key="Zf.EditorBackground" Color="#0A0600" />
    <!-- editor text -->
    <SolidColorBrush x:Key="Zf.EditorText" Color="#FFB000" />
    <!-- text caret -->
    <SolidColorBrush x:Key="Zf.Caret" Color="#FFC840" />
    <!-- board view background -->
    <SolidColorBrush x:Key="Zf.BoardBackground" Color="#0A0600" />
    <!-- the board itself -->
    <SolidColorBrush x:Key="Zf.BoardPcb" Color="#1A1000" />
    <!-- silkscreen text -->
    <SolidColorBrush x:Key="Zf.BoardText" Color="#FFB000" />
    <!-- LD0..LD3 lit -->
    <SolidColorBrush x:Key="Zf.LedOn" Color="#FFD060" />
    <!-- LED dark -->
    <SolidColorBrush x:Key="Zf.LedOff" Color="#241800" />
    <!-- input pin reading 1 -->
    <SolidColorBrush x:Key="Zf.PinHigh" Color="#FFB000" />
    <!-- input pin reading 0 -->
    <SolidColorBrush x:Key="Zf.PinLow" Color="#2A1C00" />
    <!-- output pin driving 1 -->
    <SolidColorBrush x:Key="Zf.PinDriven" Color="#FFE070" />
    <!-- output pin driving 0 -->
    <SolidColorBrush x:Key="Zf.PinDrivenLow" Color="#5A3E00" />
    <!-- pin owned by PWM -->
    <SolidColorBrush x:Key="Zf.PinPwm" Color="#FFD890" />
    <!-- push button cap -->
    <SolidColorBrush x:Key="Zf.ButtonCap" Color="#3A2800" />
    <!-- push button pressed -->
    <SolidColorBrush x:Key="Zf.ButtonCapPressed" Color="#FFB000" />

    <FontFamily x:Key="Zf.UiFont">Consolas</FontFamily>
    <FontFamily x:Key="Zf.CodeFont">Consolas</FontFamily>
    <sys:Double x:Key="Zf.UiSize">13</sys:Double>
    <sys:Double x:Key="Zf.CodeSize">15</sys:Double>
    <CornerRadius x:Key="Zf.Radius">0</CornerRadius>

    <!-- glow on terminal and editor text (retro skins), else none -->
    <DropShadowEffect x:Key="Zf.TextGlow" Color="#FFB000" BlurRadius="7" ShadowDepth="0" Opacity="0.75" />

</ResourceDictionary>
