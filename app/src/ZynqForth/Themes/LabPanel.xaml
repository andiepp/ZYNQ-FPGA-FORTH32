<!-- Generated by app/tools/make_skins.py; edit the table there. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Lab panel: an instrument front panel with an LCD terminal; shows the board. -->

    <!-- window background -->
    <LinearGradientBrush x:Key="Zf.Window" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#3A4048" />
        <GradientStop Offset="1" Color="#262A30" />
    </LinearGradientBrush>
    <!-- panel background -->
    <SolidColorBrush x:Key="Zf.Panel" Color="#30353C" />
    <!-- panel heading text -->
    <SolidColorBrush x:Key="Zf.PanelHeader" Color="#E8ECF0" />
    <!-- panel and control borders -->
    <SolidColorBrush x:Key="Zf.Border" Color="#15181C" />
    <!-- normal text -->
    <SolidColorBrush x:Key="Zf.Text" Color="#E8ECF0" />
    <!-- secondary text -->
    <SolidColorBrush x:Key="Zf.DimText" Color="#9AA3AD" />
    <!-- selected / on -->
    <SolidColorBrush x:Key="Zf.Accent" Color="#FF8A00" />
    <!-- text on the accent -->
    <SolidColorBrush x:Key="Zf.AccentText" Color="#1A1A1A" />
    <!-- errors -->
    <SolidColorBrush x:Key="Zf.Error" Color="#FF5A4A" />
    <!-- warnings -->
    <SolidColorBrush x:Key="Zf.Warning" Color="#FFD24A" />
    <!-- button face -->
    <LinearGradientBrush x:Key="Zf.ButtonBackground" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#5A626C" />
        <GradientStop Offset="1" Color="#40464E" />
    </LinearGradientBrush>
    <!-- button border -->
    <SolidColorBrush x:Key="Zf.ButtonBorder" Color="#16191D" />
    <!-- button face, hovered -->
    <LinearGradientBrush x:Key="Zf.ButtonHover" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#6A737E" />
        <GradientStop Offset="1" Color="#4C535C" />
    </LinearGradientBrush>
    <!-- button face, pressed -->
    <SolidColorBrush x:Key="Zf.ButtonPressed" Color="#2A2F35" />
    <!-- button text -->
    <SolidColorBrush x:Key="Zf.ButtonText" Color="#F2F4F6" />
    <!-- text boxes and lists -->
    <SolidColorBrush x:Key="Zf.InputBackground" Color="#1D2126" />
    <!-- text in boxes and lists -->
    <SolidColorBrush x:Key="Zf.InputText" Color="#E8ECF0" />
    <!-- selected list item -->
    <SolidColorBrush x:Key="Zf.Selection" Color="#7A4A10" />
    <!-- terminal -->
    <SolidColorBrush x:Key="Zf.TerminalBackground" Color="#B9C7A2" />
    <!-- terminal text -->
    <SolidColorBrush x:Key="Zf.TerminalText" Color="#1B2414" />
    <!-- editor -->
    <SolidColorBrush x:Key="Zf.EditorBackground" Color="#1D2126" />
    <!-- editor text -->
    <SolidColorBrush x:Key="Zf.EditorText" Color="#E8ECF0" />
    <!-- text caret -->
    <SolidColorBrush x:Key="Zf.Caret" Color="#FF8A00" />
    <!-- board view background -->
    <LinearGradientBrush x:Key="Zf.BoardBackground" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#3A4048" />
        <GradientStop Offset="1" Color="#262A30" />
    </LinearGradientBrush>
    <!-- the board itself -->
    <SolidColorBrush x:Key="Zf.BoardPcb" Color="#20262C" />
    <!-- silkscreen text -->
    <SolidColorBrush x:Key="Zf.BoardText" Color="#E8ECF0" />
    <!-- LD0..LD3 lit -->
    <SolidColorBrush x:Key="Zf.LedOn" Color="#7CFF4A" />
    <!-- LED dark -->
    <SolidColorBrush x:Key="Zf.LedOff" Color="#1A1E22" />
    <!-- input pin reading 1 -->
    <SolidColorBrush x:Key="Zf.PinHigh" Color="#7FC4FF" />
    <!-- input pin reading 0 -->
    <SolidColorBrush x:Key="Zf.PinLow" Color="#2A3036" />
    <!-- output pin driving 1 -->
    <SolidColorBrush x:Key="Zf.PinDriven" Color="#FF8A00" />
    <!-- output pin driving 0 -->
    <SolidColorBrush x:Key="Zf.PinDrivenLow" Color="#6A3A0A" />
    <!-- pin owned by PWM -->
    <SolidColorBrush x:Key="Zf.PinPwm" Color="#E05AE0" />
    <!-- push button cap -->
    <SolidColorBrush x:Key="Zf.ButtonCap" Color="#4A5058" />
    <!-- push button pressed -->
    <SolidColorBrush x:Key="Zf.ButtonCapPressed" Color="#FF8A00" />

    <FontFamily x:Key="Zf.UiFont">Bahnschrift</FontFamily>
    <FontFamily x:Key="Zf.CodeFont">Consolas</FontFamily>
    <sys:Double x:Key="Zf.UiSize">12</sys:Double>
    <sys:Double x:Key="Zf.CodeSize">14</sys:Double>
    <CornerRadius x:Key="Zf.Radius">3</CornerRadius>

    <!-- glow on terminal and editor text (retro skins), else none -->
    <x:Null x:Key="Zf.TextGlow" />

</ResourceDictionary>
