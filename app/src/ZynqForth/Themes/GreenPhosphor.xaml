<!-- Generated by app/tools/make_skins.py; edit the table there. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Green phosphor: a P1 CRT terminal, glowing text on black. -->

    <!-- window background -->
    <SolidColorBrush x:Key="Zf.Window" Color="#020802" />
    <!-- panel background -->
    <SolidColorBrush x:Key="Zf.Panel" Color="#041004" />
    <!-- panel heading text -->
    <SolidColorBrush x:Key="Zf.PanelHeader" Color="#2AD155" />
    <!-- panel and control borders -->
    <SolidColorBrush x:Key="Zf.Border" Color="#1A5C2A" />
    <!-- normal text -->
    <SolidColorBrush x:Key="Zf.Text" Color="#33FF66" />
    <!-- secondary text -->
    <SolidColorBrush x:Key="Zf.DimText" Color="#1C9E40" />
    <!-- selected / on -->
    <SolidColorBrush x:Key="Zf.Accent" Color="#33FF66" />
    <!-- text on the accent -->
    <SolidColorBrush x:Key="Zf.AccentText" Color="#021002" />
    <!-- errors -->
    <SolidColorBrush x:Key="Zf.Error" Color="#FF5050" />
    <!-- warnings -->
    <SolidColorBrush x:Key="Zf.Warning" Color="#C8FF66" />
    <!-- button face -->
    <SolidColorBrush x:Key="Zf.ButtonBackground" Color="#062A0E" />
    <!-- button border -->
    <SolidColorBrush x:Key="Zf.ButtonBorder" Color="#1F8A3C" />
    <!-- button face, hovered -->
    <SolidColorBrush x:Key="Zf.ButtonHover" Color="#0C4A1C" />
    <!-- button face, pressed -->
    <SolidColorBrush x:Key="Zf.ButtonPressed" Color="#1F8A3C" />
    <!-- button text -->
    <SolidColorBrush x:Key="Zf.ButtonText" Color="#33FF66" />
    <!-- text boxes and lists -->
    <SolidColorBrush x:Key="Zf.InputBackground" Color="#020802" />
    <!-- text in boxes and lists -->
    <SolidColorBrush x:Key="Zf.InputText" Color="#33FF66" />
    <!-- selected list item -->
    <SolidColorBrush x:Key="Zf.Selection" Color="#0E5A22" />
    <!-- terminal -->
    <SolidColorBrush x:Key="Zf.TerminalBackground" Color="#010601" />
    <!-- terminal text -->
    <SolidColorBrush x:Key="Zf.TerminalText" Color="#40FF70" />
    <!-- editor -->
    <SolidColorBrush x:Key="Zf.EditorBackground" Color="#020802" />
    <!-- editor text -->
    <SolidColorBrush x:Key="Zf.EditorText" Color="#33FF66" />
    <!-- text caret -->
    <SolidColorBrush x:Key="Zf.Caret" Color="#66FF8C" />
    <!-- board view background -->
    <SolidColorBrush x:Key="Zf.BoardBackground" Color="#020802" />
    <!-- the board itself -->
    <SolidColorBrush x:Key="Zf.BoardPcb" Color="#031A08" />
    <!-- silkscreen text -->
    <SolidColorBrush x:Key="Zf.BoardText" Color="#33FF66" />
    <!-- LD0..LD3 lit -->
    <SolidColorBrush x:Key="Zf.LedOn" Color="#66FF8C" />
    <!-- LED dark -->
    <SolidColorBrush x:Key="Zf.LedOff" Color="#0A2410" />
    <!-- input pin reading 1 -->
    <SolidColorBrush x:Key="Zf.PinHigh" Color="#33FF66" />
    <!-- input pin reading 0 -->
    <SolidColorBrush x:Key="Zf.PinLow" Color="#0A2A12" />
    <!-- output pin driving 1 -->
    <SolidColorBrush x:Key="Zf.PinDriven" Color="#C8FF66" />
    <!-- output pin driving 0 -->
    <SolidColorBrush x:Key="Zf.PinDrivenLow" Color="#2A5A10" />
    <!-- pin owned by PWM -->
    <SolidColorBrush x:Key="Zf.PinPwm" Color="#9CFFB4" />
    <!-- push button cap -->
    <SolidColorBrush x:Key="Zf.ButtonCap" Color="#0C3A18" />
    <!-- push button pressed -->
    <SolidColorBrush x:Key="Zf.ButtonCapPressed" Color="#33FF66" />

    <FontFamily x:Key="Zf.UiFont">Consolas</FontFamily>
    <FontFamily x:Key="Zf.CodeFont">Consolas</FontFamily>
    <sys:Double x:Key="Zf.UiSize">13</sys:Double>
    <sys:Double x:Key="Zf.CodeSize">15</sys:Double>
    <CornerRadius x:Key="Zf.Radius">0</CornerRadius>

    <!-- glow on terminal and editor text (retro skins), else none -->
    <DropShadowEffect x:Key="Zf.TextGlow" Color="#33FF66" BlurRadius="7" ShadowDepth="0" Opacity="0.75" />

</ResourceDictionary>
