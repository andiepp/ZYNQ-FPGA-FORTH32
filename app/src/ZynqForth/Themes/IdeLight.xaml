<!-- Generated by app/tools/make_skins.py; edit the table there. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- IDE light: the light editor look. -->

    <!-- window background -->
    <SolidColorBrush x:Key="Zf.Window" Color="#F3F3F3" />
    <!-- panel background -->
    <SolidColorBrush x:Key="Zf.Panel" Color="#FFFFFF" />
    <!-- panel heading text -->
    <SolidColorBrush x:Key="Zf.PanelHeader" Color="#5A6270" />
    <!-- panel and control borders -->
    <SolidColorBrush x:Key="Zf.Border" Color="#D6D6D6" />
    <!-- normal text -->
    <SolidColorBrush x:Key="Zf.Text" Color="#1F1F1F" />
    <!-- secondary text -->
    <SolidColorBrush x:Key="Zf.DimText" Color="#6A6F78" />
    <!-- selected / on -->
    <SolidColorBrush x:Key="Zf.Accent" Color="#005FB8" />
    <!-- text on the accent -->
    <SolidColorBrush x:Key="Zf.AccentText" Color="#FFFFFF" />
    <!-- errors -->
    <SolidColorBrush x:Key="Zf.Error" Color="#C42B1C" />
    <!-- warnings -->
    <SolidColorBrush x:Key="Zf.Warning" Color="#9A6700" />
    <!-- button face -->
    <SolidColorBrush x:Key="Zf.ButtonBackground" Color="#FBFBFB" />
    <!-- button border -->
    <SolidColorBrush x:Key="Zf.ButtonBorder" Color="#C8C8C8" />
    <!-- button face, hovered -->
    <SolidColorBrush x:Key="Zf.ButtonHover" Color="#EFEFEF" />
    <!-- button face, pressed -->
    <SolidColorBrush x:Key="Zf.ButtonPressed" Color="#D9E7F5" />
    <!-- button text -->
    <SolidColorBrush x:Key="Zf.ButtonText" Color="#1F1F1F" />
    <!-- text boxes and lists -->
    <SolidColorBrush x:Key="Zf.InputBackground" Color="#FFFFFF" />
    <!-- text in boxes and lists -->
    <SolidColorBrush x:Key="Zf.InputText" Color="#1F1F1F" />
    <!-- selected list item -->
    <SolidColorBrush x:Key="Zf.Selection" Color="#CCE4F7" />
    <!-- terminal -->
    <SolidColorBrush x:Key="Zf.TerminalBackground" Color="#FFFFFF" />
    <!-- terminal text -->
    <SolidColorBrush x:Key="Zf.TerminalText" Color="#1F1F1F" />
    <!-- editor -->
    <SolidColorBrush x:Key="Zf.EditorBackground" Color="#FFFFFF" />
    <!-- editor text -->
    <SolidColorBrush x:Key="Zf.EditorText" Color="#1F1F1F" />
    <!-- text caret -->
    <SolidColorBrush x:Key="Zf.Caret" Color="#000000" />
    <!-- board view background -->
    <SolidColorBrush x:Key="Zf.BoardBackground" Color="#F3F3F3" />
    <!-- the board itself -->
    <SolidColorBrush x:Key="Zf.BoardPcb" Color="#2D5A3F" />
    <!-- silkscreen text -->
    <SolidColorBrush x:Key="Zf.BoardText" Color="#F2F2F2" />
    <!-- LD0..LD3 lit -->
    <SolidColorBrush x:Key="Zf.LedOn" Color="#3BE85A" />
    <!-- LED dark -->
    <SolidColorBrush x:Key="Zf.LedOff" Color="#3C4A40" />
    <!-- input pin reading 1 -->
    <SolidColorBrush x:Key="Zf.PinHigh" Color="#9CC8FF" />
    <!-- input pin reading 0 -->
    <SolidColorBrush x:Key="Zf.PinLow" Color="#55606C" />
    <!-- output pin driving 1 -->
    <SolidColorBrush x:Key="Zf.PinDriven" Color="#FF6B4A" />
    <!-- output pin driving 0 -->
    <SolidColorBrush x:Key="Zf.PinDrivenLow" Color="#8A3A2A" />
    <!-- pin owned by PWM -->
    <SolidColorBrush x:Key="Zf.PinPwm" Color="#B05CC0" />
    <!-- push button cap -->
    <SolidColorBrush x:Key="Zf.ButtonCap" Color="#6C737C" />
    <!-- push button pressed -->
    <SolidColorBrush x:Key="Zf.ButtonCapPressed" Color="#3794FF" />

    <FontFamily x:Key="Zf.UiFont">Segoe UI</FontFamily>
    <FontFamily x:Key="Zf.CodeFont">Cascadia Mono, Consolas</FontFamily>
    <sys:Double x:Key="Zf.UiSize">12</sys:Double>
    <sys:Double x:Key="Zf.CodeSize">13</sys:Double>
    <CornerRadius x:Key="Zf.Radius">4</CornerRadius>

    <!-- glow on terminal and editor text (retro skins), else none -->
    <x:Null x:Key="Zf.TextGlow" />

</ResourceDictionary>
