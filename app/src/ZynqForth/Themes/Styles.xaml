<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Control styles for every skin. They only use the skin keys (Zf.*) as dynamic
         resources, so switching the skin dictionary restyles the open window. -->

    <Style x:Key="Zf.PanelBox" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Zf.Panel}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Zf.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource Zf.Radius}" />
        <Setter Property="Padding" Value="8" />
    </Style>

    <Style x:Key="Zf.Heading" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Zf.PanelHeader}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="Zf.Dim" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Zf.DimText}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource Zf.Panel}" />
        <Setter Property="Foreground" Value="{DynamicResource Zf.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Zf.Border}" />
        <Setter Property="FontFamily" Value="{DynamicResource Zf.UiFont}" />
    </Style>

    <Style TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Zf.ButtonText}" />
        <Setter Property="Background" Value="{DynamicResource Zf.ButtonBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Zf.ButtonBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,3" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Face" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource Zf.Radius}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{DynamicResource Zf.ButtonHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{DynamicResource Zf.ButtonPressed}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- a flat tab: a radio button with an accent line under the chosen one -->
    <Style x:Key="Zf.Tab" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource Zf.DimText}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,14,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Line" BorderThickness="0,0,0,2" BorderBrush="Transparent" Padding="1,0,1,2" Background="Transparent">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Line" Property="BorderBrush" Value="{DynamicResource Zf.Accent}" />
                            <Setter Property="Foreground" Value="{DynamicResource Zf.PanelHeader}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Zf.Text}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource Zf.Text}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center"
                                Background="{DynamicResource Zf.InputBackground}" BorderBrush="{DynamicResource Zf.ButtonBorder}"
                                BorderThickness="1" CornerRadius="{DynamicResource Zf.Radius}">
                            <Path x:Name="Mark" Data="M 2,7 L 5,10 L 11,3" Stroke="{DynamicResource Zf.AccentText}"
                                  StrokeThickness="2" Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Zf.Accent}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Zf.Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource Zf.InputBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource Zf.InputText}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Zf.Border}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Zf.Caret}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Zf.Accent}" />
        <Setter Property="Padding" Value="3,2" />
    </Style>

    <!-- the code text boxes: terminal, input line, editor. Transparent, so the retro skins'
         glow lights the text; the surrounding Border carries the background. -->
    <Style x:Key="Zf.Code" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontFamily" Value="{DynamicResource Zf.CodeFont}" />
        <Setter Property="FontSize" Value="{DynamicResource Zf.CodeSize}" />
        <Setter Property="Effect" Value="{DynamicResource Zf.TextGlow}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="6,4" />
    </Style>

    <Style TargetType="ListBox">
        <Setter Property="Background" Value="{DynamicResource Zf.InputBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource Zf.InputText}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Zf.Border}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>

    <Style TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource Zf.InputText}" />
        <Setter Property="Padding" Value="4,1" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Row" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource Zf.ButtonHover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource Zf.Selection}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="GridSplitter">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- combo box: a flat button with the skin's colours and a skinned drop-down -->
    <ControlTemplate x:Key="Zf.ComboToggle" TargetType="ToggleButton">
        <Border x:Name="Face" Background="{DynamicResource Zf.ButtonBackground}" BorderBrush="{DynamicResource Zf.ButtonBorder}"
                BorderThickness="1" CornerRadius="{DynamicResource Zf.Radius}">
            <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,7,0" Data="M 0,0 L 4,4 L 8,0"
                  Stroke="{DynamicResource Zf.ButtonText}" StrokeThickness="1.5" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Face" Property="Background" Value="{DynamicResource Zf.ButtonHover}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource Zf.ButtonText}" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Template="{StaticResource Zf.ComboToggle}" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                        <ContentPresenter Margin="8,2,22,2" VerticalAlignment="Center" IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
                        <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True"
                               Focusable="False" PopupAnimation="None">
                            <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="320" Background="{DynamicResource Zf.Panel}"
                                    BorderBrush="{DynamicResource Zf.ButtonBorder}" BorderThickness="1">
                                <ScrollViewer>
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource Zf.Text}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Row" Background="Transparent" Padding="8,3">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource Zf.Selection}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- thin scroll bars in the skin's colours -->
    <Style x:Key="Zf.ScrollThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="{DynamicResource Zf.ButtonBorder}" CornerRadius="3" Margin="2" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="10" />
        <Setter Property="MinWidth" Value="10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.Thumb>
                            <Thumb Style="{StaticResource Zf.ScrollThumb}" />
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="10" />
                <Setter Property="MinHeight" Value="10" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Track x:Name="PART_Track" IsDirectionReversed="False">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource Zf.ScrollThumb}" />
                                </Track.Thumb>
                            </Track>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
